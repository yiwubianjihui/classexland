<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     x:Class="ClassExland.Features.Remote.RemoteSettingsPage">
    <ScrollViewer>
        <StackPanel Margin="20,16,20,32" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="远程控制" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="让另一台设备或你自己的服务器改这台教室电脑的配置、切换布局、下发指令。不配置也能完全离线使用。"
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 状态卡：一眼看出当前能不能用 -->
            <Border BorderThickness="1" BorderBrush="#33808080" CornerRadius="8" Padding="14,12">
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="StatusBadge" Text="未启用" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusSubText" Text="" Opacity="0.65" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="LastSyncText" Text="" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ① 连接服务器 -->
            <StackPanel Spacing="8">
                <TextBlock Text="① 连接服务器" FontWeight="SemiBold" />
                <TextBlock Text="地址和访问令牌由服务器管理员提供。它们只保存在本机配置里，插件代码中不含任何地址或密钥。"
                           Opacity="0.7" TextWrapping="Wrap" />

                <CheckBox x:Name="EnabledCheck" Content="启用远程控制" />

                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器地址" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ServerUrlBox" Margin="0,0,0,8"
                             Watermark="https://你的域名" TextChanged="ServerUrlBox_OnTextChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="设备名称" VerticalAlignment="Center" Margin="0,0,12,8" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="DeviceBox" Margin="0,0,0,8"
                             Watermark="留空表示不指定（一台设备时可不填）"
                             TextChanged="DeviceBox_OnTextChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="访问令牌" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TokenBox" PasswordChar="●"
                             Watermark="管理员提供的一串字符" />
                </Grid>

                <TextBlock Text="一个服务器可以管多台教室电脑：在远程站上按名字登记（如「初一2班」），这里填同一个名字，就只会拿到这台电脑自己的配置快照与指令。第一次用新名字时服务器会自动登记一台空设备；服务器上有多台而这里没填，同步结果会列出可选的名字。"
                           Opacity="0.65" FontSize="12" TextWrapping="Wrap" />

                <TextBlock x:Name="EndpointHint" Text="清单地址：填好服务器地址后自动生成"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />

                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ButtonSaveTest" Content="保存并测试" Classes="accent" Margin="0,0,8,8"
                            Click="ButtonSaveTest_OnClick" />
                    <Button x:Name="ButtonSync" Content="立即同步" Margin="0,0,8,8" Click="ButtonSync_OnClick" />
                    <Button x:Name="ButtonDisable" Content="停用" Margin="0,0,0,8" Click="ButtonDisable_OnClick" />
                </WrapPanel>
            </StackPanel>

            <Separator />

            <!-- ② 允许远程做什么 -->
            <StackPanel Spacing="6">
                <TextBlock Text="② 允许远程做什么" FontWeight="SemiBold" />
                <TextBlock Text="只勾选你确实需要的项；不确定就保持默认。"
                           Opacity="0.7" TextWrapping="Wrap" />
                <CheckBox x:Name="SnapshotCheck" Content="同步插件配置（预备铃、值日表、活动、布局）—— 推荐" />
                <CheckBox x:Name="CommandsCheck" Content="接受远程指令（切换布局、改预备铃、值日表操作）—— 推荐" />
                <CheckBox x:Name="CoreCheck" Content="同步 ClassIsland 课程表与全局设置" />
                <TextBlock Text="⚠ 最后一项是高风险操作：会用服务器上的版本覆盖本机课程表与设置，只有确实需要统一管理时才勾选。"
                           Foreground="#D9534F" FontSize="12" TextWrapping="Wrap" Margin="24,0,0,0" />
            </StackPanel>

            <Separator />

            <!-- ③ 本机网页控制台 -->
            <StackPanel Spacing="8">
                <TextBlock Text="③ 本机网页控制台（可选）" FontWeight="SemiBold" />
                <TextBlock Text="不想记命令就用这个：开启后在浏览器里点几下即可控制。只监听本机 127.0.0.1，同网段的其他设备访问不到。"
                           Opacity="0.7" TextWrapping="Wrap" />
                <CheckBox x:Name="WebConsoleCheck" Content="启用本机网页控制台（本次运行有效）"
                          Click="WebConsoleCheck_OnClick" />
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto">
                    <TextBox Grid.Column="0" x:Name="WebUrlBox" IsReadOnly="True" Margin="0,0,8,0"
                             Watermark="未启动" FontSize="12" />
                    <Button Grid.Column="1" x:Name="ButtonOpenWeb" Content="打开" Margin="0,0,8,0"
                            Click="ButtonOpenWeb_OnClick" />
                    <Button Grid.Column="2" x:Name="ButtonCopyWeb" Content="复制链接" Click="ButtonCopyWeb_OnClick" />
                </Grid>
            </StackPanel>

            <!-- 高级：普通用户不用碰 -->
            <Expander Header="高级选项（一般不用改）">
                <StackPanel Spacing="8" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="清单路径" VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="ManifestPathBox" Margin="0,0,0,8"
                                 Watermark="/config/manifest.json" TextChanged="ManifestPathBox_OnTextChanged" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="签名密钥" VerticalAlignment="Center" Margin="0,0,12,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SecretBox" PasswordChar="●" Margin="0,0,0,8"
                                 Watermark="可选；管理员要求时才填" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="超时（秒）" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TimeoutBox" Width="120" HorizontalAlignment="Left"
                                 Watermark="15" />
                    </Grid>

                    <TextBlock Text="以下信息用于排查问题，复制给管理员即可。令牌不会出现在诊断信息里。"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="PathsText" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="ButtonOpenFolder" Content="打开配置文件夹" Margin="0,4,8,0"
                                Click="ButtonOpenFolder_OnClick" />
                        <Button x:Name="ButtonCopyDiag" Content="复制诊断信息" Margin="0,4,0,0"
                                Click="ButtonCopyDiag_OnClick" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- 操作结果 -->
            <TextBlock x:Name="StatusText" Text="" Opacity="0.9" TextWrapping="Wrap" MinHeight="20" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
